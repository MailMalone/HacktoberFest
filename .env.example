# Optional. Authenticated GitHub API access raises the rate limit from 60 to 5,000 requests/hour.
GITHUB_TOKEN=
# Web comments: token needs access to the selected repository and Pull requests: write
# (or Issues: write). Restart the app after changing .env. Rate limits still apply.
# Claim monitor is read-only. Public repository scans need no write permissions;
# private repository scans need repository access with Issues and Pull requests: read.

# Required for web and CLI classification with OpenRouter models.
# PR title/body metadata goes to OpenRouter and the selected provider after consent.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

